<Track #port-vfs-editor-component version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "移植 infra-dev/vfs-editor 为 xnl.ts 子包 `packages/vfs-editor`(xnl-vfs-editor)——可复用 Vue3 组件库，数据层重写到 xnl-vfs(+xnl-vcs)、布局存 vfs extend(键稳定 XNL id·不反写 XNL)、显式保存=commit；并在 demo/vfs-editor 建消费该组件的可运行应用。" description = "落实 eidolon-workbench DEPA 分析（xnl-editor-depa-refactor）的 D1/D2 与 R1/R2/R4/R5：把自造 vfs 的独立应用收敛到 xnl 生态的成熟中立库，抽成可复用组件 + demo。重 UI 依赖作 peerDeps；构建用 vite lib(Vue SFC)。本 track 完工后再做 workbench 侧 track。" type = "feature" commit_mode = "manual" created_at = "2026-06-21T00:00:00Z" updated_at = "2026-06-21T00:00:00Z" } (
