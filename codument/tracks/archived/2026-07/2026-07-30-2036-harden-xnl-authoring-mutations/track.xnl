<Track #harden-xnl-authoring-mutations version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "为 xnl-core 增加保持 #id identity 语义的原子 mutation dry-run、precondition、identity diagnostics 与完整 diff/apply parity。" description = "面向 XNL-backed authoring 提供严格但 opt-in 的 mutation transaction 原语；保留 diffNodes/applyMutations 兼容，不把 #id 当作普通字段更新。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-07-30T16:04:06Z" updated_at = "2026-07-30T17:36:55Z" gap-round = 2 } (
