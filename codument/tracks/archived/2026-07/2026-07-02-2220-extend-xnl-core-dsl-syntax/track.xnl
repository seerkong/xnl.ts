<Track #extend-xnl-core-dsl-syntax version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "Support dotted FQN tag names (`&lt;dg.materials.CrudTable&gt;`) in xnl-core parser with roundtrip fidelity and zero regression on path/mutation/loader tooling." description = "Downstream dg-cell-mvi lowcode v3 unit DSL uses definition FQNs as element-tree tags. Only gap found by capability verification: parseNode tag reading rejects '.'. Additive grammar change; tag stays a joined string." type = "feature" commit_mode = "manual" created_at = "2026-07-02T19:12:00Z" updated_at = "2026-07-02T19:20:00Z" } (
