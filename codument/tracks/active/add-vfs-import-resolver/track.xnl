<Track #add-vfs-import-resolver version="1" apiVersion="codument.tech/v1alpha1" { status = "in_progress" goal = "Add cross-file vfs-import resolution to xnl-core: parse `&lt;Imports&gt;&lt;Import as src=\"vfs://\"&gt;`, build per-alias symbol tables (same-alias merge, duplicate error), reuse loader exports/batchLoad, with dependency-inverted resolver and zero-import fallback." description = "Implement the xnl-import capability so XNL documents can import file/directory targets by vfs path under an alias namespace, enabling fractal multi-file registries (downstream: codument add-modeling-registry)." type = "feature" commit_mode = "manual" created_at = "2026-06-20T00:00:00Z" updated_at = "2026-06-20T00:00:00Z" } (
  <Ports { scope = "track" } [
    <MaterialBundle { role = "input" name = "behavior-deltas" domain = "behavior" path = "vfs://./behavior_deltas/" }>
    <MaterialBundle { role = "output" name = "behavior" domain = "codument" path = "vfs://@/codument/behaviors/" }>
    <MaterialBundle { role = "output" name = "core" domain = "code" path = "vfs://@/packages/core/src/" }>
  ]>
