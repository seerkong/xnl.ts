{
  "name": "xnl-vfs",
  "version": "0.1.2",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./revisioned-persistence": {
      "types": "./dist/revisioned-persistence.d.ts",
      "import": "./dist/revisioned-persistence.js",
      "require": "./dist/revisioned-persistence.cjs"
    },
    "./persistence-mode": {
      "types": "./dist/persistence-mode.d.ts",
      "import": "./dist/persistence-mode.js",
      "require": "./dist/persistence-mode.cjs"
    },
    "./local-fs-persistence": {
      "types": "./dist/local-fs-persistence.d.ts",
      "import": "./dist/local-fs-persistence.js",
      "require": "./dist/local-fs-persistence.cjs"
    },
    "./indexeddb-persistence": {
      "types": "./dist/indexeddb-persistence.d.ts",
      "import": "./dist/indexeddb-persistence.js",
      "require": "./dist/indexeddb-persistence.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com"
  },
  "dependencies": {
    "diff": "8.0.3",
    "xnl-collab-core": "workspace:*",
    "xnl-core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "fake-indexeddb": "^6.2.5",
    "tsup": "^8.2.4",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
