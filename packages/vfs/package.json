{
  "name": "xnl-vfs",
  "version": "0.2.1",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./indexeddb-backup": {
      "types": "./dist/indexeddb-backup.d.ts",
      "import": "./dist/indexeddb-backup.js",
      "require": "./dist/indexeddb-backup.cjs"
    },
    "./managed-fs-workspace": {
      "types": "./dist/managed-fs-workspace.d.ts",
      "import": "./dist/managed-fs-workspace.js",
      "require": "./dist/managed-fs-workspace.cjs"
    },
    "./file-workspace": {
      "types": "./dist/file-workspace.d.ts",
      "import": "./dist/file-workspace.js",
      "require": "./dist/file-workspace.cjs"
    },
    "./text-content-history": {
      "types": "./dist/text-content-history.d.ts",
      "import": "./dist/text-content-history.js",
      "require": "./dist/text-content-history.cjs"
    },
    "./local-fs-content-history": {
      "types": "./dist/local-fs-content-history.d.ts",
      "import": "./dist/local-fs-content-history.js",
      "require": "./dist/local-fs-content-history.cjs"
    },
    "./xnl-content-history": {
      "types": "./dist/xnl-content-history.d.ts",
      "import": "./dist/xnl-content-history.js",
      "require": "./dist/xnl-content-history.cjs"
    },
    "./content-history": {
      "types": "./dist/content-history.d.ts",
      "import": "./dist/content-history.js",
      "require": "./dist/content-history.cjs"
    },
    "./indexeddb-content-history": {
      "types": "./dist/indexeddb-content-history.d.ts",
      "import": "./dist/indexeddb-content-history.js",
      "require": "./dist/indexeddb-content-history.cjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./revisioned-persistence": {
      "types": "./dist/revisioned-persistence.d.ts",
      "import": "./dist/revisioned-persistence.js",
      "require": "./dist/revisioned-persistence.cjs"
    },
    "./overlay-materialization": {
      "types": "./dist/overlay-materialization.d.ts",
      "import": "./dist/overlay-materialization.js",
      "require": "./dist/overlay-materialization.cjs"
    },
    "./persistence-mode": {
      "types": "./dist/persistence-mode.d.ts",
      "import": "./dist/persistence-mode.js",
      "require": "./dist/persistence-mode.cjs"
    },
    "./local-fs-persistence": {
      "types": "./dist/local-fs-persistence.d.ts",
      "import": "./dist/local-fs-persistence.js",
      "require": "./dist/local-fs-persistence.cjs"
    },
    "./indexeddb-persistence": {
      "types": "./dist/indexeddb-persistence.d.ts",
      "import": "./dist/indexeddb-persistence.js",
      "require": "./dist/indexeddb-persistence.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com"
  },
  "dependencies": {
    "diff": "8.0.3",
    "immutable-data-core": "0.1.0",
    "xnl-collab-core": "0.1.4",
    "xnl-core": "0.1.14"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "fake-indexeddb": "^6.2.5",
    "tsup": "^8.2.4",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
