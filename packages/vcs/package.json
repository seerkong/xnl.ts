{
  "name": "xnl-vcs",
  "version": "0.1.3",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./revisioned-repository": {
      "types": "./dist/revisioned-repository.d.ts",
      "import": "./dist/revisioned-repository.js",
      "require": "./dist/revisioned-repository.cjs"
    },
    "./indexeddb-backend": {
      "types": "./dist/indexeddb-backend.d.ts",
      "import": "./dist/indexeddb-backend.js",
      "require": "./dist/indexeddb-backend.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com"
  },
  "dependencies": {
    "xnl-core": "0.1.13",
    "xnl-collab-core": "0.1.3",
    "xnl-vfs": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsup": "^8.2.4",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
