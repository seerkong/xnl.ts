  },
  "devDependencies": {
    "vue": "^3.5.26",
    "pinia": "^3.0.4",
    "element-plus": "^2.13.0",
    "@element-plus/icons-vue": "^2.3.2",
    "ag-grid-community": "^35.0.0",
    "ag-grid-vue3": "^35.0.0",
