{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun-types"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "xnl-core": ["../core/src/index.ts"],
      "xnl-collab-core": ["../collab-core/src/index.ts"],
      "xnl-collab-protocol": ["../collab-protocol/src/index.ts"],
      "xnl-collab-server": ["../collab-server/src/index.ts"]
    }
  },
  "include": ["src", "tsup.config.ts"]
}
