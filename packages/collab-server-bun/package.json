{
  "name": "xnl-collab-server-bun",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:seerkong/xnl.ts.git"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target es2020",
    "test": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "xnl-collab-server": "workspace:*"
  },
  "devDependencies": {
    "bun-types": "latest",
    "tsup": "^8.2.4",
    "typescript": "^5.6.3"
  }
}
